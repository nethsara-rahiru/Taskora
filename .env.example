PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/taskora
JWT_SECRET=your_jwt_secret_here
SESSION_SECRET=your_session_secret_here

FRONTDESK_API_URL=https://api.frontdesk.example/v1
FRONTDESK_API_KEY=your_frontdesk_api_key
FRONTDESK_AGENT_ID=your_frontdesk_agent_id

# Stable secret for encrypting per-user Groq keys saved through Settings.
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Back this up and keep it unchanged across restarts. A configured JWT_SECRET
# of at least 32 characters can also be used as a fallback.
AI_ENCRYPTION_KEY=
